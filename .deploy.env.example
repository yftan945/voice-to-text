# 複製成 .deploy.env（不進 git），給 scripts/deploy.sh、set-hf-token.sh、e2e.sh 讀
DEPLOY_HOST=gpu-host                 # GPU 主機的 ssh 主機名稱
DEPLOY_DIR=docker/voice-to-text      # 部署目錄（相對於家目錄，只接受 docker/ 底下）
DEPLOY_URL=http://192.168.1.10:8810  # 線上服務網址（部署前查進行中的任務）
VTT_URL=http://192.168.1.10:8810     # e2e.sh 預設網址
OP_ITEM="HuggingFace token"          # 1Password 項目名稱
OP_VAULT=Private                     # 1Password vault
